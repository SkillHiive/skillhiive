    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.14",
    "react-native-reanimated": "4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "@types/react": "^19.2.2",
    "@types/react-native": "^0.73.0",
    "react": "^19.2.0",
    "react-native": "0.83.6"
  },
  "files": [
    "dist"
  ]

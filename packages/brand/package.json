{
  "name": "@skillhiive/brand",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./hooks/useTokens": {
      "types": "./dist/hooks/useTokens.d.ts",
      "import": "./dist/hooks/useTokens.js",
      "default": "./dist/hooks/useTokens.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "@types/react": "^19.2.2",
    "tailwindcss": "^4.1.17"
  },
  "files": [
    "dist"
  ]
}
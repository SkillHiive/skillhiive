    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@skillhiive/core": "workspace:*",
    "@skillhiive/brand": "workspace:*",
    "@skillhiive/contracts": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "files": [
    "dist"
  ]
}